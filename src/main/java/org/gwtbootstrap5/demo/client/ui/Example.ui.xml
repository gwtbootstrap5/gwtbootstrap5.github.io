<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui">
    <g:HTMLPanel styleName="demo-example">
        <h3 ui:field="heading" class="h5 mt-5"/>
        <p ui:field="description" class="text-body-secondary"/>
        <div class="card">
            <g:SimplePanel ui:field="live" styleName="card-body demo-live"/>
            <div class="card-footer d-flex justify-content-end py-1">
                <button ui:field="toggle" type="button" class="btn btn-sm btn-link text-decoration-none"
                        data-bs-toggle="collapse" aria-expanded="false">
                    <i class="bi bi-code-slash me-1"/>Code
                </button>
            </div>
            <b:Collapse ui:field="sources" toggle="false">
                <g:FlowPanel ui:field="codes" styleName="demo-sources"/>
            </b:Collapse>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>
