<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Tables</h1>
        <p class="lead"><code>CellTable</code> with Bootstrap's table styles: striped, hover, bordered, small, dark and responsive.</p>
        <d:Example ui:field="striped" heading="Striped rows with hover" description="A `CellTable` with `striped` and `hover`; the columns and rows come from Java."/>
        <d:Example ui:field="bordered" heading="Bordered, small and dark" description="`bordered`, `condensed` (Bootstrap's `table-sm`) and `dark` combine freely."/>
        <d:Example ui:field="responsiveTable" heading="Responsive tables" description="Wrap the table in a `div` with `table-responsive` to let it scroll horizontally when it doesn't fit."/>
    </g:HTMLPanel>
</ui:UiBinder>
