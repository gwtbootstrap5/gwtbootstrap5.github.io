<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui"
             xmlns:b.gwt="urn:import:org.gwtbootstrap5.client.ui.gwt"
             xmlns:b.html="urn:import:org.gwtbootstrap5.client.ui.html">
    <g:HTMLPanel>
        <b.html:Div addStyleNames="d-flex flex-wrap gap-2">
            <b:DropDown direction="UP">
                <b:Button type="PRIMARY" dataToggle="DROPDOWN" text="Dropup"/>
                <b:DropDownMenu>
                    <b:AnchorListItem text="Action"/>
                    <b:AnchorListItem text="Another action"/>
                </b:DropDownMenu>
            </b:DropDown>
            <b:DropDown direction="END">
                <b:Button type="PRIMARY" dataToggle="DROPDOWN" text="Dropend"/>
                <b:DropDownMenu>
                    <b:AnchorListItem text="Action"/>
                    <b:AnchorListItem text="Another action"/>
                </b:DropDownMenu>
            </b:DropDown>
            <b:DropDown>
                <b:Button type="SECONDARY" dataToggle="DROPDOWN" text="End-aligned"/>
                <b:DropDownMenu alignment="END">
                    <b:AnchorListItem text="A longer action"/>
                    <b:AnchorListItem text="Another action"/>
                </b:DropDownMenu>
            </b:DropDown>
            <b:DropDown>
                <b:Button type="DARK" dataToggle="DROPDOWN" text="Dark"/>
                <b:DropDownMenu dark="true">
                    <b:AnchorListItem text="Action" active="true"/>
                    <b:AnchorListItem text="Another action"/>
                </b:DropDownMenu>
            </b:DropDown>
        </b.html:Div>
    </g:HTMLPanel>
</ui:UiBinder>
