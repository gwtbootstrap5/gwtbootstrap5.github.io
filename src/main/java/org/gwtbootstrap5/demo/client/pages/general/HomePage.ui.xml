<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:HTMLPanel>
        <div class="py-4 py-lg-5 mb-4 border-bottom">
            <h1 class="display-5 fw-bold">GwtBootstrap5</h1>
            <p class="lead col-lg-9">
                Bootstrap 5.3 for GWT: every Bootstrap component as a widget you can use from Java and UiBinder,
                plus extras for date pickers, rich text, selects, sliders and more.
                Every page of this demo shows the widgets running, next to the UiBinder code that creates them.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary btn-lg" href="#setup">Get started</a>
                <a class="btn btn-outline-secondary btn-lg" href="https://github.com/gwtbootstrap5/gwtbootstrap5-parent"
                   target="_blank" rel="noopener"><i class="bi bi-github me-1"/>GitHub</a>
            </div>
        </div>

        <h2 class="h4">What's new in 0.2.0</h2>
        <ul class="mb-4">
            <li>JsInterop instead of JSNI, and no jQuery in the core module.</li>
            <li>New components: Offcanvas, Accordion items, Switch, FloatingLabel, Placeholder, InputColor,
                Ratio, stacks and color modes.</li>
            <li>Dropdowns controlled from Java, fullscreen modals, horizontal and flush list groups.</li>
            <li>Published on Maven Central as <code>io.github.gwtbootstrap5</code>.</li>
        </ul>
        <p>
            Upgrading from 0.1.x? Read
            <a href="https://github.com/gwtbootstrap5/gwtbootstrap5-parent/blob/master/UPGRADING.md">UPGRADING.md</a>.
        </p>

        <g:FlowPanel ui:field="sections" styleName="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-2"/>
    </g:HTMLPanel>
</ui:UiBinder>
