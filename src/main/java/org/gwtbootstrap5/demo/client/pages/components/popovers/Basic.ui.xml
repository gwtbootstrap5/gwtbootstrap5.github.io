<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui"
             xmlns:b.gwt="urn:import:org.gwtbootstrap5.client.ui.gwt"
             xmlns:b.html="urn:import:org.gwtbootstrap5.client.ui.html">
    <g:HTMLPanel>
        <b.html:Div addStyleNames="d-flex flex-wrap gap-2">
            <b:Popover title="Popover on top" content="Top popover." placement="TOP" trigger="CLICK">
                <b:Button type="SECONDARY" text="Top"/>
            </b:Popover>
            <b:Popover title="Popover on the right" content="Right popover." placement="RIGHT" trigger="CLICK">
                <b:Button type="SECONDARY" text="Right"/>
            </b:Popover>
            <b:Popover title="Popover at the bottom" content="Bottom popover." placement="BOTTOM" trigger="CLICK">
                <b:Button type="SECONDARY" text="Bottom"/>
            </b:Popover>
            <b:Popover title="Popover on the left" content="Left popover." placement="LEFT" trigger="CLICK">
                <b:Button type="SECONDARY" text="Left"/>
            </b:Popover>
        </b.html:Div>
    </g:HTMLPanel>
</ui:UiBinder>
