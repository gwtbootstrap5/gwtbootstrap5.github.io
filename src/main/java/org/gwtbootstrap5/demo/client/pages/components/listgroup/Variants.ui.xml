<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui"
             xmlns:b.gwt="urn:import:org.gwtbootstrap5.client.ui.gwt"
             xmlns:b.html="urn:import:org.gwtbootstrap5.client.ui.html">
    <g:HTMLPanel>
        <b:ListGroup flush="true" addStyleNames="mb-3">
            <b:ListGroupItem text="Flush item"/>
            <b:ListGroupItem text="Flush item"/>
        </b:ListGroup>
        <b:ListGroup numbered="true" addStyleNames="mb-3">
            <b:ListGroupItem text="First"/>
            <b:ListGroupItem text="Second"/>
            <b:ListGroupItem text="Third"/>
        </b:ListGroup>
        <b:ListGroup horizontal="MD">
            <b:ListGroupItem text="One"/>
            <b:ListGroupItem text="Two"/>
            <b:ListGroupItem text="Three"/>
        </b:ListGroup>
    </g:HTMLPanel>
</ui:UiBinder>
