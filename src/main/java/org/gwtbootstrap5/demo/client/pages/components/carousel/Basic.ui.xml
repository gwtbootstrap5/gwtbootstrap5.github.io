<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui"
             xmlns:b.gwt="urn:import:org.gwtbootstrap5.client.ui.gwt"
             xmlns:b.html="urn:import:org.gwtbootstrap5.client.ui.html">
    <g:HTMLPanel>
        <b:Carousel b:id="carousel-basic">
            <b:CarouselIndicators>
                <b:CarouselIndicator dataTarget="#carousel-basic" dataSlideTo="0" active="true"/>
                <b:CarouselIndicator dataTarget="#carousel-basic" dataSlideTo="1"/>
                <b:CarouselIndicator dataTarget="#carousel-basic" dataSlideTo="2"/>
            </b:CarouselIndicators>
            <b:CarouselInner>
                <b:CarouselSlide active="true">
                    <b:Image url="images/landscape.svg" altText="First slide" addStyleNames="d-block w-100"/>
                    <b:CarouselCaption addStyleNames="d-none d-md-block">
                        <b:Heading size="H5" text="First slide"/>
                    </b:CarouselCaption>
                </b:CarouselSlide>
                <b:CarouselSlide>
                    <b:Image url="images/landscape.svg" altText="Second slide" addStyleNames="d-block w-100"/>
                    <b:CarouselCaption addStyleNames="d-none d-md-block">
                        <b:Heading size="H5" text="Second slide"/>
                    </b:CarouselCaption>
                </b:CarouselSlide>
                <b:CarouselSlide>
                    <b:Image url="images/landscape.svg" altText="Third slide" addStyleNames="d-block w-100"/>
                    <b:CarouselCaption addStyleNames="d-none d-md-block">
                        <b:Heading size="H5" text="Third slide"/>
                    </b:CarouselCaption>
                </b:CarouselSlide>
            </b:CarouselInner>
            <b:CarouselControl prev="true" href="#carousel-basic" text="Previous"/>
            <b:CarouselControl next="true" href="#carousel-basic" text="Next"/>
        </b:Carousel>
    </g:HTMLPanel>
</ui:UiBinder>
