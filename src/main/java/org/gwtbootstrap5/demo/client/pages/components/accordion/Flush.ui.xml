<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui"
             xmlns:b.gwt="urn:import:org.gwtbootstrap5.client.ui.gwt"
             xmlns:b.html="urn:import:org.gwtbootstrap5.client.ui.html">
    <g:HTMLPanel>
        <b:Accordion flush="true" alwaysOpen="true">
            <b:AccordionItem open="true">
                <b:AccordionHeader text="First"/>
                <b:AccordionBody>
                    <b.html:Paragraph addStyleNames="mb-0">Opening another item leaves this one open.</b.html:Paragraph>
                </b:AccordionBody>
            </b:AccordionItem>
            <b:AccordionItem open="true">
                <b:AccordionHeader text="Second"/>
                <b:AccordionBody>
                    <b.html:Paragraph addStyleNames="mb-0">Both items started open.</b.html:Paragraph>
                </b:AccordionBody>
            </b:AccordionItem>
            <b:AccordionItem>
                <b:AccordionHeader text="Third"/>
                <b:AccordionBody>
                    <b.html:Paragraph addStyleNames="mb-0">This one started closed.</b.html:Paragraph>
                </b:AccordionBody>
            </b:AccordionItem>
        </b:Accordion>
    </g:HTMLPanel>
</ui:UiBinder>
