<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Images</h1>
        <p class="lead">Responsive, thumbnail, rounded and circular images, and figures with a caption.</p>
        <d:Example ui:field="fluid" heading="Responsive images" description="`FLUID` scales the image down with its parent and never past its own width."/>
        <d:Example ui:field="types" heading="Thumbnails and shapes" description="`THUMBNAIL` adds a border and padding; `ROUNDED` and `CIRCLE` round the corners."/>
        <d:Example ui:field="figure" heading="Figures" description="A `Figure` holds an image and its `FigCaption`."/>
    </g:HTMLPanel>
</ui:UiBinder>
