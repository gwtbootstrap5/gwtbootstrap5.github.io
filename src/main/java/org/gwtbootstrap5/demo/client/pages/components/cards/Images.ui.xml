<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui"
             xmlns:b.gwt="urn:import:org.gwtbootstrap5.client.ui.gwt"
             xmlns:b.html="urn:import:org.gwtbootstrap5.client.ui.html">
    <g:HTMLPanel>
        <b:CardGroup>
            <b:Card>
                <b:CardImage cardImagePosition="TOP" url="images/landscape.svg" altText="A placeholder image"/>
                <b:CardBody>
                    <b:CardTitle size="H5" text="First card"/>
                    <b:CardText>This card has supporting text below as a natural lead-in to additional content.</b:CardText>
                </b:CardBody>
            </b:Card>
            <b:Card>
                <b:CardImage cardImagePosition="TOP" url="images/landscape.svg" altText="A placeholder image"/>
                <b:CardBody>
                    <b:CardTitle size="H5" text="Second card"/>
                    <b:CardText>This card is shorter.</b:CardText>
                </b:CardBody>
            </b:Card>
            <b:Card>
                <b:CardImage cardImagePosition="TOP" url="images/landscape.svg" altText="A placeholder image"/>
                <b:CardBody>
                    <b:CardTitle size="H5" text="Third card"/>
                    <b:CardText>This card has even longer content than the first, to show the equal height of the group.</b:CardText>
                </b:CardBody>
            </b:Card>
        </b:CardGroup>
    </g:HTMLPanel>
</ui:UiBinder>
