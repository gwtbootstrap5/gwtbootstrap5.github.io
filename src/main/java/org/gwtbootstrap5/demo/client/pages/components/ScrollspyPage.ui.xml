<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Scrollspy</h1>
        <p class="lead">Highlights the link of the section in view: <code>ScrollSpy</code>, started from Java once the page is attached.</p>
        <d:Example ui:field="basic" heading="Basic" description="`ScrollSpy.scrollSpy(scrollingWidget, &quot;#navId&quot;)` watches a scrolling element and marks the nav link whose target is in view. The links point at the sections&#x27; ids, and `data-bs-smooth-scroll` keeps their clicks from changing the page&#x27;s history token."/>
    </g:HTMLPanel>
</ui:UiBinder>
