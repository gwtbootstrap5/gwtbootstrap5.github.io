<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui"
             xmlns:b.gwt="urn:import:org.gwtbootstrap5.client.ui.gwt"
             xmlns:b.html="urn:import:org.gwtbootstrap5.client.ui.html">
    <g:HTMLPanel>
        <b:Button ui:field="toggle" type="SECONDARY" text="Toggle"/>
        <b.html:Span ui:field="status" addStyleNames="ms-2">Hidden.</b.html:Span>
        <b:Collapse ui:field="collapse" toggle="false">
            <b:Card>
                <b:CardBody>
                    <b.html:Paragraph addStyleNames="mb-0">Toggled from Java.</b.html:Paragraph>
                </b:CardBody>
            </b:Card>
        </b:Collapse>
    </g:HTMLPanel>
</ui:UiBinder>
