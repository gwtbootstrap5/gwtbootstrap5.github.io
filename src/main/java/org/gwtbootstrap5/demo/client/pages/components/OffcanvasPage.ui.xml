<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Offcanvas</h1>
        <p class="lead">A panel that slides in from an edge of the window: <code>Offcanvas</code>.</p>
        <d:Example ui:field="basic" heading="Basic" description="A button with `dataToggle=&quot;OFFCANVAS&quot;` and a `dataTarget` opens it. The `OffcanvasHeader`&#x27;s `title` labels the panel, and its close button closes it."/>
        <d:Example ui:field="fromJava" heading="Placement, from Java" description="`placement` picks the edge. `show()` opens the panel (and adds it to the page if it isn&#x27;t yet), and `scroll=&quot;true&quot;` with `backdrop=&quot;FALSE&quot;` keeps the page usable while it is open."/>
    </g:HTMLPanel>
</ui:UiBinder>
