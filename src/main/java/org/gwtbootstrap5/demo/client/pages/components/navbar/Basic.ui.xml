<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui"
             xmlns:b.gwt="urn:import:org.gwtbootstrap5.client.ui.gwt"
             xmlns:b.html="urn:import:org.gwtbootstrap5.client.ui.html">
    <g:HTMLPanel>
        <b:Navbar addStyleNames="bg-body-tertiary rounded">
            <b:Container size="FLUID">
                <b:NavbarBrand href="#components/navbar" text="Navbar"/>
                <b:NavbarCollapseButton dataTarget="#navbar-basic" ariaControls="navbar-basic"/>
                <b:NavbarCollapse b:id="navbar-basic">
                    <b:NavbarNav addStyleNames="me-auto">
                        <b:AnchorListItem text="Home" active="true" targetHistoryToken="components/navbar"/>
                        <b:AnchorListItem text="Link" targetHistoryToken="components/navbar"/>
                        <b:NavbarDropdown>
                            <b:NavbarDropdownButton text="Dropdown"/>
                            <b:DropDownMenu>
                                <b:AnchorListItem text="Action"/>
                                <b:AnchorListItem text="Another action"/>
                                <b:Divider/>
                                <b:AnchorListItem text="Something else here"/>
                            </b:DropDownMenu>
                        </b:NavbarDropdown>
                        <b:AnchorListItem text="Disabled" enabled="false"/>
                    </b:NavbarNav>
                    <b:NavbarForm addStyleNames="d-flex">
                        <b:TextBox placeholder="Search" addStyleNames="me-2"/>
                        <b:Button type="SUCCESS_OUTLINE" text="Search"/>
                    </b:NavbarForm>
                </b:NavbarCollapse>
            </b:Container>
        </b:Navbar>
    </g:HTMLPanel>
</ui:UiBinder>
