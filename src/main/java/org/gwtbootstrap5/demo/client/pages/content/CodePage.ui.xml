<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Code</h1>
        <p class="lead">Inline code, code blocks, user input and sample output.</p>
        <d:Example ui:field="inline" heading="Inline code" description="`Code` wraps a fragment of code inside text."/>
        <d:Example ui:field="block" heading="Code blocks" description="`Pre` keeps the line breaks and spacing of multiple lines of code."/>
        <d:Example ui:field="kbd" heading="User input and variables" description="Bootstrap also styles the `kbd`, `var` and `samp` HTML elements."/>
    </g:HTMLPanel>
</ui:UiBinder>
