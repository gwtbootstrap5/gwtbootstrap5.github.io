<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui"
             xmlns:b.gwt="urn:import:org.gwtbootstrap5.client.ui.gwt"
             xmlns:b.html="urn:import:org.gwtbootstrap5.client.ui.html">
    <g:HTMLPanel>
        <b:NavPills>
            <b:NavTabItem ui:field="first" text="First" dataTarget="#pill-first" active="true"/>
            <b:NavTabItem ui:field="second" text="Second" dataTarget="#pill-second"/>
        </b:NavPills>
        <b:TabContent addStyleNames="py-3">
            <b:TabPanel b:id="pill-first" active="true">
                <b.html:Paragraph addStyleNames="mb-0">The first pill's content.</b.html:Paragraph>
            </b:TabPanel>
            <b:TabPanel b:id="pill-second">
                <b.html:Paragraph addStyleNames="mb-0">The second pill's content.</b.html:Paragraph>
            </b:TabPanel>
        </b:TabContent>
        <b:Button ui:field="showSecond" type="SECONDARY" size="SMALL" text="Show the second tab"/>
        <b.html:Span ui:field="status" addStyleNames="ms-2">Showing: First.</b.html:Span>
    </g:HTMLPanel>
</ui:UiBinder>
