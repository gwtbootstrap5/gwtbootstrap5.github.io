<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui"
             xmlns:b.gwt="urn:import:org.gwtbootstrap5.client.ui.gwt"
             xmlns:b.html="urn:import:org.gwtbootstrap5.client.ui.html">
    <g:HTMLPanel>
        <b:Form ui:field="form">
            <b:FormGroup addStyleNames="mb-3">
                <b:FormLabel for="v-name" text="Name" showRequiredIndicator="true"/>
                <b:TextBox b:id="v-name" allowBlank="false" validateOnBlur="true"/>
                <b:HelpBlock/>
            </b:FormGroup>
            <b:FormGroup addStyleNames="mb-3">
                <b:FormLabel for="v-email" text="Email" showRequiredIndicator="true"/>
                <b:TextBox ui:field="email" b:id="v-email" allowBlank="false" validateOnBlur="true"/>
                <b:HelpBlock/>
            </b:FormGroup>
            <b:FormGroup addStyleNames="mb-3">
                <b:FormLabel for="v-password" text="Password" showRequiredIndicator="true"/>
                <b:Input ui:field="password" type="PASSWORD" b:id="v-password" allowBlank="false" validateOnBlur="true"/>
                <b:HelpBlock text="At least 8 characters."/>
            </b:FormGroup>
            <b:FormGroup addStyleNames="mb-3">
                <b:FormLabel for="v-confirm" text="Confirm password"/>
                <b:Input ui:field="confirm" type="PASSWORD" b:id="v-confirm" validateOnBlur="true"/>
                <b:HelpBlock/>
            </b:FormGroup>
            <b:Button ui:field="submit" type="PRIMARY" text="Sign up"/>
            <b:Button ui:field="reset" type="LINK" text="Reset"/>
        </b:Form>
    </g:HTMLPanel>
</ui:UiBinder>
