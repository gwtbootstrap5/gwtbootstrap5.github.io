<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Close button</h1>
        <p class="lead">The <code>CloseButton</code> that alerts, modals and offcanvas use to dismiss themselves, on its own.</p>
        <d:Example ui:field="basic" heading="Basic" description="`setWhite(true)` is for dark backgrounds; with a color mode, the button follows `data-bs-theme` instead. Add an `aria-label` for screen readers."/>
