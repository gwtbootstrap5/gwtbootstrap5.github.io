<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Breadcrumbs</h1>
        <p class="lead">Where the current page is in the site's hierarchy: <code>Breadcrumbs</code> with an <code>AnchorListItem</code> per level.</p>
        <d:Example ui:field="basic" heading="Basic" description="The last item is the current page: it is marked `active` and `aria-current=&quot;page&quot;`."/>
        <d:Example ui:field="divider" heading="Divider" description="Change the separator with the `--bs-breadcrumb-divider` CSS variable."/>
    </g:HTMLPanel>
</ui:UiBinder>
