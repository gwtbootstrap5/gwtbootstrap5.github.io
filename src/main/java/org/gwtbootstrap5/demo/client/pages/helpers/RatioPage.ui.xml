<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Ratio</h1>
        <p class="lead">Keep an element at an aspect ratio as its width changes, like an embedded video: <code>Ratio</code>.</p>
        <d:Example ui:field="types" heading="Aspect ratios" description="`type` is `R1X1`, `R4X3`, `R16X9` (the default) or `R21X9`. The child fills the box."/>
        <d:Example ui:field="image" heading="An image" description="An image in a 16:9 `Ratio` is cropped to fill it with `object-fit-cover`."/>
    </g:HTMLPanel>
</ui:UiBinder>
