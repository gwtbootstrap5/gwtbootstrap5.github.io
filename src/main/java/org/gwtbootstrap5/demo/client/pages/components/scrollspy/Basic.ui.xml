<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:org.gwtbootstrap5.client.ui"
             xmlns:b.gwt="urn:import:org.gwtbootstrap5.client.ui.gwt"
             xmlns:b.html="urn:import:org.gwtbootstrap5.client.ui.html">
    <g:HTMLPanel>
        <b:NavPills b:id="scrollspy-nav" addStyleNames="mb-2">
            <b:AnchorListItem text="First" href="#scrollspy-first"/>
            <b:AnchorListItem text="Second" href="#scrollspy-second"/>
            <b:AnchorListItem text="Third" href="#scrollspy-third"/>
        </b:NavPills>
        <b.html:Div ui:field="box" addStyleNames="position-relative overflow-y-auto border rounded p-3" height="200px">
            <b:Heading size="H4" b:id="scrollspy-first" text="First heading"/>
            <b.html:Paragraph height="250px">This is the first section. Scroll down and the nav above follows.</b.html:Paragraph>
            <b:Heading size="H4" b:id="scrollspy-second" text="Second heading"/>
            <b.html:Paragraph height="250px">This is the second section.</b.html:Paragraph>
            <b:Heading size="H4" b:id="scrollspy-third" text="Third heading"/>
            <b.html:Paragraph height="250px">This is the third and last section.</b.html:Paragraph>
        </b.html:Div>
    </g:HTMLPanel>
</ui:UiBinder>
