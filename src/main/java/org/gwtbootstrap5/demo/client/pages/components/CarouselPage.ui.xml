<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Carousel</h1>
        <p class="lead">A slideshow: <code>Carousel</code>, with slides, captions, indicators and controls.</p>
        <d:Example ui:field="basic" heading="With indicators and controls" description="The indicators and the controls point at the carousel&#x27;s id. It cycles every five seconds and pauses on hover."/>
        <d:Example ui:field="fromJava" heading="Fade, from Java" description="`fade` cross-fades the slides and `autoplay=&quot;false&quot;` stops it cycling by itself. `goToPrev()`, `goToNext()` and `jumpToSlide(int)` move it, and `addSlidHandler` runs after each slide."/>
    </g:HTMLPanel>
</ui:UiBinder>
