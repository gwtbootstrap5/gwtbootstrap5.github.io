<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Stacks</h1>
        <p class="lead">Flexbox shorthands: <code>VStack</code> and <code>HStack</code> stack their children with a gap, and <code>VerticalRule</code> separates them.</p>
        <d:Example ui:field="vertical" heading="Vertical" description="A `VStack` puts its children one under the other; `gap` is 0 to 5."/>
        <d:Example ui:field="horizontal" heading="Horizontal, with a vertical rule" description="An `HStack` puts them side by side; `ms-auto` pushes an item to the end, and a `VerticalRule` draws a separator."/>
        <d:Example ui:field="form" heading="A form row" description="Stacks also line up form controls and buttons."/>
    </g:HTMLPanel>
</ui:UiBinder>
