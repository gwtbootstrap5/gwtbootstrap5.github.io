<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Placeholders</h1>
        <p class="lead">Loading placeholders that keep the layout while content loads: <code>Placeholder</code>.</p>
        <d:Example ui:field="basic" heading="Basic" description="`columnSize` sets the width like a grid column, `size` the height and `color` the background."/>
        <d:Example ui:field="card" heading="Animated card" description="Animate a group with `StyleHelper.setPlaceholderAnimation(container, GLOW)` or `WAVE`."/>
    </g:HTMLPanel>
</ui:UiBinder>
