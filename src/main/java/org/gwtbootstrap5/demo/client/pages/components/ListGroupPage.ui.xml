<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>List group</h1>
        <p class="lead">Lists of items: <code>ListGroup</code> with <code>ListGroupItem</code>s, and <code>LinkedGroup</code> for links.</p>
        <d:Example ui:field="basic" heading="Basic" description="Items take a `type` for contextual colors."/>
        <d:Example ui:field="variants" heading="Flush, numbered and horizontal" description="`flush` removes the outer borders, `numbered` numbers the items, `horizontal` lays them in a row from a breakpoint up."/>
        <d:Example ui:field="links" heading="Links" description="A `LinkedGroup` holds `LinkedGroupItem`s, which are links with `href` or `targetHistoryToken`, `active` and a `type`."/>
    </g:HTMLPanel>
</ui:UiBinder>
