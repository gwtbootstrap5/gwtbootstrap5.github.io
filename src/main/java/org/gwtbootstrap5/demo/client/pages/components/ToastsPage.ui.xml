<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Toasts</h1>
        <p class="lead">Lightweight notifications: <code>Toast</code>, shown in a <code>ToastContainer</code>.</p>
        <d:Example ui:field="basic" heading="Basic" description="A `Toast` is built from Java with a title, a subtitle and a message. `setAutohide(false)` keeps it until it is closed."/>
        <d:Example ui:field="live" heading="Showing toasts" description="Put a `ToastContainer` in a corner of the window, add toasts to it and `show()` them. They hide after `setDelay` milliseconds (five seconds by default); remove them in `addHiddenHandler`."/>
    </g:HTMLPanel>
</ui:UiBinder>
