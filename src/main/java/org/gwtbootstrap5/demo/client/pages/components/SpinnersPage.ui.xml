<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Spinners</h1>
        <p class="lead">Loading indicators: <code>Spinner</code> with a <code>BORDER</code> or <code>GROW</code> animation.</p>
        <d:Example ui:field="types" heading="Border and grow" description="The constructor takes the `SpinnerType` and the text read by screen readers. `emphasis` colors it."/>
        <d:Example ui:field="small" heading="Small, and in buttons" description="`small` shrinks the spinner, which fits a button that is waiting."/>
    </g:HTMLPanel>
</ui:UiBinder>
