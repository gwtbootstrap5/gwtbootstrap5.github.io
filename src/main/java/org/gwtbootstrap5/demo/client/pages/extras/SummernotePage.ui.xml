<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Summernote</h1>
        <p class="lead">A WYSIWYG editor, by <a href="https://summernote.org/">Summernote</a> 0.9 for Bootstrap 5. Inherit <code>org.gwtbootstrap5.extras.summernote.Summernote</code>.</p>
        <d:Example ui:field="basic" heading="Editor" description="`defaultHeight` and `placeholder` set up the editor; `getCode()` returns its HTML and `setCode` replaces it."/>
        <d:Example ui:field="air" heading="Air mode" description="`airMode` hides the toolbar until text is selected; `addSummernoteChangeHandler` runs on every change."/>
    </g:HTMLPanel>
</ui:UiBinder>
