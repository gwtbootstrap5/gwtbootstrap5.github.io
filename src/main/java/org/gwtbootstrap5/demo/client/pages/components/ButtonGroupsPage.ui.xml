<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Button groups</h1>
        <p class="lead">Buttons side by side: <code>ButtonGroup</code>, <code>VerticalButtonGroup</code> and <code>ButtonToolBar</code>, plus check and radio buttons.</p>
        <d:Example ui:field="basic" heading="Basic" description="A `ButtonGroup` joins its buttons; `size` sizes them all."/>
        <d:Example ui:field="toolbar" heading="Toolbar and vertical" description="A `ButtonToolBar` lines groups up; a `VerticalButtonGroup` stacks its buttons."/>
        <d:Example ui:field="checks" heading="Check and radio buttons" description="`CheckBoxButton` and `RadioButton` look like buttons and keep their value: radios with the same `name` are exclusive."/>
    </g:HTMLPanel>
</ui:UiBinder>
