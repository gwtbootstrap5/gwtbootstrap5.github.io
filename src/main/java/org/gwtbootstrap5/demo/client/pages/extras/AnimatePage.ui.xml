<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Animate</h1>
        <p class="lead">CSS animations from <a href="https://animate.style/">animate.css</a> 4, started from Java with <code>Animate.animate</code>. Inherit <code>org.gwtbootstrap5.extras.animate.Animate</code>.</p>
        <d:Example ui:field="basic" heading="Animating a widget" description="`Animate.animate(widget, Animation.TADA)` plays an animation once and returns its classes; `removeAnimationOnEnd` removes them when it ends. The overloads take a repeat count, a duration and a delay in milliseconds."/>
    </g:HTMLPanel>
</ui:UiBinder>
