<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Badges</h1>
        <p class="lead">Small counts and labels: <code>Badge</code>, which replaces Bootstrap 3's <code>Label</code>.</p>
        <d:Example ui:field="headings" heading="In headings" description="A badge scales with its parent&#x27;s font size. Headings, buttons and list items take a `badgeText`."/>
        <d:Example ui:field="types" heading="Types" description="`type` takes a `BadgeType`, which writes Bootstrap&#x27;s `text-bg-*` classes so the text keeps its contrast."/>
        <d:Example ui:field="buttons" heading="In buttons" description="On buttons, `badgePosition` puts the badge before or after the text."/>
    </g:HTMLPanel>
</ui:UiBinder>
