<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Validation</h1>
        <p class="lead">Validators on the controls, and messages in the <code>HelpBlock</code> of each <code>FormGroup</code>.</p>
        <d:Example ui:field="signUp" heading="Validating a form" description="`allowBlank=&quot;false&quot;` makes a field required and `validateOnBlur` checks it when it loses focus. Add other validators in Java; `Form.validate()` checks every field and `reset()` clears the form and its errors."/>
    </g:HTMLPanel>
</ui:UiBinder>
