<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Range slider</h1>
        <p class="lead">Sliders with one or two handles, by <a href="https://github.com/seiyria/bootstrap-slider">bootstrap-slider</a> 11. Inherit <code>org.gwtbootstrap5.extras.range.Range</code>.</p>
        <d:Example ui:field="basic" heading="Slider and range slider" description="A `Slider` has one handle and a `Double` value; a `RangeSlider` has two and a `Range`, written `[min,max]` in UiBinder."/>
        <d:Example ui:field="ticks" heading="Ticks and labels" description="`setTicks` and `setTicksLabels` snap the handle to marked values."/>
    </g:HTMLPanel>
</ui:UiBinder>
