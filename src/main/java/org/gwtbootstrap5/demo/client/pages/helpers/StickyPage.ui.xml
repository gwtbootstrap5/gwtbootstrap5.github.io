<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:org.gwtbootstrap5.demo.client.ui">
    <g:HTMLPanel>
        <h1>Sticky</h1>
        <p class="lead">Keep an element at the top or bottom of the viewport while the page scrolls: <code>StickyHelper</code>, or <code>sticky</code> on a <code>Div</code>. It replaces <code>Affix</code>, deprecated in 0.3.1.</p>
        <d:Example ui:field="positions" heading="Top and bottom" description="`sticky` is `TOP`, `BOTTOM`, or one of them from a breakpoint up: `SM_TOP` … `XXL_BOTTOM`."/>
        <d:Example ui:field="offset" heading="An offset, from Java" description="`StickyHelper.setSticky` takes a distance from the edge, and `removeSticky` undoes it."/>
    </g:HTMLPanel>
</ui:UiBinder>
